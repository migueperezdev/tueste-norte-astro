---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/Badge.astro";
import { getCafeBySlug } from "../../lib/wp";

export const prerender = false;

const { slug } = Astro.params;
const cafe = slug ? await getCafeBySlug(slug) : null;

if (!cafe) {
  Astro.response.status = 404;
}
---

<BaseLayout
  titulo={cafe?.nombre ?? "Café no encontrado"}
  descripcion={cafe
    ? `Descubre el café ${cafe.nombre}, de ${cafe.origen}.`
    : "El café que buscas no está disponible."}
>
  <a
    href="/cafes/"
    class="font-semibold text-amber-800 hover:underline"
  >
    ← Volver al catálogo
  </a>

  {cafe ? (
    <article class="mt-8 grid gap-8 md:grid-cols-2">
      {cafe.imagen && (
        <img
          src={cafe.imagen}
          alt={cafe.imagenAlt}
          class="h-96 w-full rounded-xl bg-white object-contain"
        />
      )}

      <div>
        <h1 class="text-4xl font-bold text-amber-800">
          {cafe.nombre}
        </h1>

        <div class="mt-5 flex flex-wrap gap-2">
          <Badge texto={cafe.origen} tono="origen" />
          <Badge texto={"Tueste " + cafe.tueste} tono="tueste" />
        </div>

        <h2 class="mt-6 text-xl font-bold text-stone-900">
          Notas de cata
        </h2>

        <p class="mt-2 leading-relaxed text-stone-700">
          {cafe.notas}
        </p>

        <p class="mt-6 text-2xl font-bold text-amber-800">
          {cafe.precio.toFixed(2)} €
          <span class="text-sm font-normal text-stone-600">
            / 250 g
          </span>
        </p>

        <h2 class="mt-8 text-xl font-bold text-stone-900">
          Descripción
        </h2>

        <div
          class="mt-3 leading-relaxed text-stone-700 [&_p]:mb-4"
          set:html={cafe.descripcionHtml}
        />
      </div>
    </article>
  ) : (
    <section class="mt-8">
      <h1 class="text-4xl font-bold text-amber-800">
        Café no encontrado
      </h1>
      <p class="mt-4 text-stone-700">
        Este café no está disponible.
      </p>
    </section>
  )}
</BaseLayout>
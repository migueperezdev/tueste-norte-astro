---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articulos = await getCollection("blog", ({ data }) => !data.draft);

articulos.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout
  titulo="Blog"
  descripcion="Recetas y métodos para preparar café en casa con Tueste Norte."
>
  <h1 class="text-4xl font-bold text-amber-800">
    Nuestro blog
  </h1>

  <p class="mt-4 text-lg leading-relaxed text-stone-700">
    Aprende a preparar café en casa con nuestras recetas y métodos.
  </p>

  <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      articulos.map((articulo) => (
        <article class="flex h-full flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
          <h2 class="text-2xl font-bold text-stone-900">
            {articulo.data.title}
          </h2>

          <time
            datetime={articulo.data.pubDate.toISOString()}
            class="mt-3 block text-sm text-stone-600"
          >
            {articulo.data.pubDate.toLocaleDateString("es-ES", {
              dateStyle: "long",
              timeZone: "UTC",
            })}
          </time>

          <p class="mt-4 leading-relaxed text-stone-700">
            {articulo.data.description}
          </p>

          <a
            href={`/blog/${articulo.id}`}
            aria-label={`Leer: ${articulo.data.title}`}
            class="mt-auto pt-6 font-semibold text-amber-800 hover:underline"
          >
            Leer artículo
          </a>
        </article>
      ))
    }
  </div>
</BaseLayout>
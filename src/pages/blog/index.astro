---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticulos } from "../../lib/wp";

export const prerender = false;

const articulos = await getArticulos();
---

<BaseLayout
  titulo="Blog"
  descripcion="Recetas y métodos para preparar café en casa con Tueste Norte."
>
  <h1 class="text-4xl font-bold text-amber-800">
    Nuestro blog
  </h1>

  <p class="mt-4 text-lg leading-relaxed text-stone-700">
    Aprende a preparar café en casa con nuestras recetas y métodos.
  </p>

  {articulos.length === 0 ? (
    <p class="mt-8 text-stone-700">
      Todavía no hay artículos publicados.
    </p>
  ) : (
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {articulos.map((articulo) => (
        <article class="flex h-full flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
          {articulo.imagen && (
            <img
              src={articulo.imagen}
              alt={articulo.imagenAlt}
              loading="lazy"
              class="mb-5 h-56 w-full rounded-lg object-cover"
            />
          )}

          <h2 class="text-2xl font-bold text-stone-900">
            {articulo.titulo}
          </h2>

          <time
            datetime={articulo.fecha.toISOString()}
            class="mt-3 block text-sm text-stone-600"
          >
            {articulo.fecha.toLocaleDateString("es-ES", {
              dateStyle: "long",
              timeZone: "UTC",
            })}
          </time>

          <p class="mt-4 leading-relaxed text-stone-700">
            {articulo.resumen}
          </p>

          <a
            href={`/blog/${articulo.slug}/`}
            aria-label={`Leer: ${articulo.titulo}`}
            class="mt-auto pt-6 font-semibold text-amber-800 hover:underline"
          >
            Leer artículo
          </a>
        </article>
      ))}
    </div>
  )}
</BaseLayout>
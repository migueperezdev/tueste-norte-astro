---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticuloBySlug } from "../../lib/wp";

export const prerender = false;

const { slug } = Astro.params;
const articulo = slug ? await getArticuloBySlug(slug) : null;

if (!articulo) {
  Astro.response.status = 404;
}
---

<BaseLayout
  titulo={articulo?.titulo ?? "Artículo no encontrado"}
  descripcion={articulo?.resumen || "Recetas y consejos de Tueste Norte."}
>
  <div class="mx-auto max-w-3xl">
    <a
      href="/blog/"
      class="font-semibold text-amber-800 hover:underline"
    >
      ← Volver al blog
    </a>

    {articulo ? (
      <article>
        <header class="mt-6">
          <h1 class="text-4xl font-bold leading-tight text-amber-800">
            {articulo.titulo}
          </h1>

          <p class="mt-4 text-lg leading-relaxed text-stone-700">
            {articulo.resumen}
          </p>

          <p class="mt-4 text-sm text-stone-600">
            <time datetime={articulo.fecha.toISOString()}>
              {articulo.fecha.toLocaleDateString("es-ES", {
                dateStyle: "long",
                timeZone: "UTC",
              })}
            </time>
            {" · "}
            {articulo.autor}
          </p>
        </header>

        {articulo.imagen && (
          <img
            src={articulo.imagen}
            alt={articulo.imagenAlt}
            class="mt-8 h-80 w-full rounded-xl object-cover"
          />
        )}

        <div
          class="contenido mt-8 rounded-xl border border-stone-200 bg-white p-6 md:p-8"
          set:html={articulo.contenidoHtml}
        />
      </article>
    ) : (
      <section class="mt-6">
        <h1 class="text-4xl font-bold text-amber-800">
          Artículo no encontrado
        </h1>

        <p class="mt-4 text-stone-700">
          Este artículo no está disponible.
        </p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .contenido {
    color: #44403c;
    line-height: 1.8;
  }

  .contenido :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #92400e;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .contenido :global(p) {
    margin: 1rem 0;
  }

  .contenido :global(ul),
  .contenido :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .contenido :global(ul) {
    list-style-type: disc;
  }

  .contenido :global(ol) {
    list-style-type: decimal;
  }

  .contenido :global(li) {
    margin: 0.4rem 0;
  }
</style>
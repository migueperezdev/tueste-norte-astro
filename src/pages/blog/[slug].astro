---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  articulo: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const articulos = await getCollection(
    "blog",
    ({ data }) => !data.draft
  );

  return articulos.map((articulo) => ({
    params: { slug: articulo.id },
    props: { articulo },
  }));
}

const { articulo } = Astro.props;
const { Content } = await render(articulo);
---

<BaseLayout
  titulo={articulo.data.title}
  descripcion={articulo.data.description}
>
  <article class="mx-auto max-w-3xl">
    <a
      href="/blog"
      class="font-semibold text-amber-800 hover:underline"
    >
      ← Volver al blog
    </a>

    <header class="mt-6">
      <h1 class="text-4xl font-bold leading-tight text-amber-800">
        {articulo.data.title}
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-stone-700">
        {articulo.data.description}
      </p>

      <p class="mt-4 text-sm text-stone-600">
        <time datetime={articulo.data.pubDate.toISOString()}>
          {
            articulo.data.pubDate.toLocaleDateString("es-ES", {
              dateStyle: "long",
              timeZone: "UTC",
            })
          }
        </time>
        · {articulo.data.author}
      </p>
    </header>

    <div class="contenido mt-8 rounded-xl border border-stone-200 bg-white p-6 md:p-8">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .contenido {
    color: #44403c;
    line-height: 1.8;
  }

  .contenido :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #92400e;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .contenido :global(p) {
    margin: 1rem 0;
  }

  .contenido :global(ul),
  .contenido :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .contenido :global(ul) {
    list-style-type: disc;
  }

  .contenido :global(ol) {
    list-style-type: decimal;
  }

  .contenido :global(li) {
    margin: 0.4rem 0;
  }
</style>
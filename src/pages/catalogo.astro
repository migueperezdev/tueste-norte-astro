---
import BaseLayout from "../layouts/BaseLayout.astro";
import CafeCard from "../components/CafeCard.astro";

interface Cafe {
  nombre: string;
  origen: string;
  notas: string;
  tueste: "claro" | "medio" | "oscuro";
  precio: number;
}

const cafes: Cafe[] = [
  {
    nombre: "Sidamo Floral",
    origen: "Sidamo, Etiopía",
    notas: "Jazmín, bergamota y arándanos",
    tueste: "claro",
    precio: 14.5,
  },
  {
    nombre: "Sierra Dulce",
    origen: "Huila, Colombia",
    notas: "Frutos rojos, panela y cacao",
    tueste: "claro",
    precio: 13.2,
  },
  {
    nombre: "Cerrado Natural",
    origen: "Cerrado Mineiro, Brasil",
    notas: "Cacao, avellana y caramelo",
    tueste: "oscuro",
    precio: 11.9,
  },
  {
    nombre: "Volcán de Antigua",
    origen: "Antigua, Guatemala",
    notas: "Chocolate, caramelo y naranja",
    tueste: "medio",
    precio: 12.5,
  },
];
---

<BaseLayout
  titulo="Catálogo"
  descripcion="Descubre los cafés de especialidad de Tueste Norte."
>
  <h1 class="text-4xl font-bold text-amber-800">
    Nuestro catálogo
  </h1>

  <p class="mt-4 text-lg leading-relaxed text-stone-700">
    Cuatro cafés de origen, tostados en pequeños lotes para
    destacar sus aromas y sabores. Precios por paquete de 250 g.
  </p>

  <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {cafes.map((cafe) => (
      <CafeCard
        nombre={cafe.nombre}
        origen={cafe.origen}
        notas={cafe.notas}
        tueste={cafe.tueste}
        precio={cafe.precio}
      />
    ))}
  </div>
</BaseLayout>

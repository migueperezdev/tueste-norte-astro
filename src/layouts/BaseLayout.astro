---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  titulo: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = "Tostadero de café de especialidad, tienda física y catas mensuales.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <title>{titulo} · Tueste Norte</title>
  </head>

  <body class="flex min-h-screen flex-col bg-stone-100 text-stone-900">
    <Header />

    <main class="mx-auto w-full max-w-6xl flex-1 px-6 py-12">
      <slot />
    </main>

    <Footer />
  </body>
</html>
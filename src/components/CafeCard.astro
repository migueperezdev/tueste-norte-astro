---
import Badge from "./Badge.astro";

interface Props {
  nombre: string;
  origen: string;
  notas: string;
  tueste: "claro" | "medio" | "oscuro";
  precio: number;
  imagen?: string | null;
  imagenAlt?: string;
  slug?: string;
}

const {
  nombre,
  origen,
  notas,
  tueste,
  precio,
  imagen = null,
  imagenAlt = nombre,
  slug,
} = Astro.props;
---

<article
  class="flex h-full flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
>
  {
    imagen && (
      <img
        src={imagen}
        alt={imagenAlt}
        loading="lazy"
        class="mb-5 h-56 w-full rounded-lg bg-stone-50 object-contain"
      />
    )
  }
  <h2 class="text-2xl font-bold text-stone-900">
    {nombre}
  </h2>

  <div class="mt-4 flex flex-wrap gap-2">
    <Badge texto={origen} tono="origen" />
    <Badge texto={"Tueste " + tueste} tono="tueste" />
  </div>

  <p class="mt-5 text-sm font-semibold text-stone-900">Notas de cata</p>

  <p class="mt-1 leading-relaxed text-stone-700">
    {notas}
  </p>

  <p class="mt-auto pt-6 text-xl font-bold text-amber-800">
    {precio.toFixed(2)} €
    <span class="text-sm font-normal text-stone-600"> / 250 g </span>
  </p>
  {
    slug && (
      <a
        href={`/cafes/${slug}/`}
        aria-label={`Ver ficha de ${nombre}`}
        class="mt-5 font-semibold text-amber-800 hover:underline"
      >
        Ver ficha →
      </a>
    )
  }
</article>
